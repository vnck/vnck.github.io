---
import Tags from './Tags.astro';
import { formatDate, postUrl, readingTime, type Post } from '../utils/index';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, modified_date: modifiedDate, tags, redirect_to, reading_time } = post.data;
---
<div class="post-item">
  <h4>
    <a href={postUrl(post)}>{title}</a>
  </h4>
  {description && <p class="caption">{description}</p>}
  <div class="caption-container">
    {redirect_to && <><p>[ Redirect ]</p><p>&ensp;·&ensp;</p></>}
    {modifiedDate ? (
      <>
        <p style="text-decoration:line-through;">{formatDate(date)}</p>
        <p>&nbsp;{formatDate(modifiedDate)}</p>
      </>
    ) : (
      <p>{formatDate(date)}</p>
    )}
    <p>&ensp;·&ensp;</p>
    <p>{readingTime(post.body, reading_time)} min</p>
    <p>&ensp;·&ensp;</p>
    <p><Tags tags={tags} /></p>
  </div>
</div>
