---
import Tags from './Tags.astro';
import Doodle from './Doodle.astro';
import { formatDate } from '../utils/index';

interface Props {
  title: string;
  date: Date;
  modifiedDate?: Date;
  tags: string[];
  // 1 when the entry is the whole page, so the page has a top-level heading; 2 in the journal list.
  headingLevel?: 1 | 2;
}

const { title, date, modifiedDate, tags, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 1 ? 'h1' : 'h2';
---
<div class="journal-post">
  <Heading class="journal-post-title">{title}</Heading>
  <div class="journal-post-content">
    <slot />
  </div>
  <div class="journal-post-footer">
    {modifiedDate ? (
      <>
        <p>{formatDate(modifiedDate)}&nbsp;&nbsp;</p>
        <p style="text-decoration:line-through;">{formatDate(date)}</p>
      </>
    ) : (
      <p>{formatDate(date)}</p>
    )}
    <p>&ensp;·&ensp;</p>
    <p><Tags tags={tags} /></p>
  </div>
  <div class="journal-post-break" aria-hidden="true"><Doodle name="asterisk" /><Doodle name="asterisk" tilt={14} /><Doodle name="asterisk" tilt={-9} /></div>
</div>
