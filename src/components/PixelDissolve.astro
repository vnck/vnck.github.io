---
import { GLYPHS, GLYPH_ROWS } from '../utils/pixelFont';

interface Props {
  phrases: string[];
  intervalMs?: number;
}
const { phrases, intervalMs = 12000 } = Astro.props;

// Seeded so every build scatters the pixels the same way and the HTML doesn't churn.
function rng(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// Each word is its own SVG so the line wraps between words like ordinary text. Built as a string
// because Astro would otherwise stamp its scoping attribute onto every one of the pixels.
function wordsSvg(phrase: string, seed: number) {
  const random = rng(seed);
  return phrase.split(' ').map(word => {
    let rects = '';
    let x = 0;
    for (const ch of word) {
      const glyph = GLYPHS.get(ch) ?? GLYPHS.get('?')!;
      glyph.forEach((row, y) => {
        [...row].forEach((p, dx) => {
          if (p === '#') rects += `<rect x="${x + dx}" y="${y}" width="1" height="1" style="--d:${random().toFixed(2)}"/>`;
        });
      });
      x += glyph[0].length + 1;
    }
    const w = x - 1;
    return `<svg viewBox="0 0 ${w} ${GLYPH_ROWS}" width="${w * 3}" height="${GLYPH_ROWS * 3}" shape-rendering="crispEdges">${rects}</svg>`;
  }).join('');
}
---

<span class="pixel-dissolve" aria-hidden="true" data-interval={intervalMs}>
  {phrases.map((phrase, i) => (
    <span class:list={['pd-phrase', { 'is-in': i === 0 }]} set:html={wordsSvg(phrase, i + 1)} />
  ))}
</span>
<span class="pixel-dissolve-sr">{phrases[0]}</span>

<style>
  /* The tagline is drawn as square pixels: a deliberately digital counterpoint to the hand-drawn
     doodles. Every phrase is stacked in the same grid cell, so the box is always as tall as the
     longest one and cycling never shifts the page. */
  .pixel-dissolve {
    --dissolve: 1s;
    --glow: 130ms;
    display: grid;
  }

  .pd-phrase {
    grid-area: 1 / 1;
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: 12px 9px;
  }

  .pd-phrase :global(svg) {
    display: block;
  }

  .pd-phrase :global(rect) {
    fill: var(--faded);
    opacity: 0;
  }

  /* Each pixel flips at its own random moment (--d), glowing in the accent colour for --glow on
     the way in or out: a dissolve rather than a wipe. The resting state lives in the base rules and
     the animation only fills backwards, so a pixel can't be left holding a keyframe colour. */
  .pd-phrase.is-in :global(rect) {
    opacity: 1;
    animation: pd-in var(--glow) step-end calc(var(--d) * var(--dissolve)) backwards;
  }

  .pd-phrase.is-out :global(rect) {
    animation: pd-out var(--glow) step-end calc(var(--d) * var(--dissolve)) backwards;
  }

  @keyframes pd-in {
    0% { opacity: 0; }
    1%, 100% { opacity: 1; fill: var(--accent); }
  }

  @keyframes pd-out {
    0% { opacity: 1; }
    1%, 100% { opacity: 1; fill: var(--accent); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pd-phrase.is-in :global(rect) { animation: none; }
  }

  .pixel-dissolve-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.pixel-dissolve');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && !reduceMotion) {
    const phrases = [...root.querySelectorAll('.pd-phrase')];
    let current = 0;
    setInterval(() => {
      phrases[current].classList.replace('is-in', 'is-out');
      current = (current + 1) % phrases.length;
      phrases[current].classList.remove('is-out');
      phrases[current].classList.add('is-in');
    }, Number(root.dataset.interval));
  }
</script>
