---
interface Props {
  class?: string;
  width?: string;
}

const { class: extraClass, width = '100%' } = Astro.props;

type Pt = [number, number];

// Generate a wobbly line procedurally
function wobblyLine(w: number, segments: number): Pt[] {
  const pts: Pt[] = [];
  const step = w / segments;
  
  const phase1 = Math.random() * Math.PI * 2;
  const phase2 = Math.random() * Math.PI * 2;
  
  const freq1 = 0.8 + Math.random() * 0.8;
  const freq2 = 1.5 + Math.random() * 1.5;
  
  const amp1 = 0.8 + Math.random() * 0.6;
  const amp2 = 0.5 + Math.random() * 0.5;

  for (let i = 0; i <= segments; i++) {
    const x = i * step;
    // Y should wobble around 4 (middle of 0-8)
    const y = 4 + amp1 * Math.sin(phase1 + i * freq1) + amp2 * Math.cos(phase2 + i * freq2);
    pts.push([x, y]);
  }
  return pts;
}

const pts = wobblyLine(600, 10);

// Densify sparse hand-plotted points with a Catmull-Rom curve so the line flows smoothly.
function densify(pts: Pt[], steps = 8): Pt[] {
  if (pts.length < 3) return pts;
  const out: Pt[] = [];
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[Math.max(i - 1, 0)], p1 = pts[i], p2 = pts[i + 1], p3 = pts[Math.min(i + 2, pts.length - 1)];
    for (let s = 0; s < steps; s++) {
      const t = s / steps, t2 = t * t, t3 = t2 * t;
      const f = (a: number, b: number, c: number, d: number) =>
        0.5 * (2 * b + (-a + c) * t + (2 * a - 5 * b + 4 * c - d) * t2 + (-a + 3 * b - 3 * c + d) * t3);
      out.push([f(p0[0], p1[0], p2[0], p3[0]), f(p0[1], p1[1], p2[1], p3[1])]);
    }
  }
  out.push(pts[pts.length - 1]);
  return out;
}

const toPath = (pts: Pt[]) =>
  densify(pts).map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(2)} ${y.toFixed(2)}`).join('');

const pathData = toPath(pts);
---
<svg class={['doodle-line', extraClass].filter(Boolean).join(' ')} viewBox="0 0 600 8" preserveAspectRatio="none" aria-hidden="true" focusable="false" style={`width: ${width}; height: 8px; display: block;`}>
  <path d={pathData} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
</svg>
