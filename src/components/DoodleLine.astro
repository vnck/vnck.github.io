---
import { toPath, type Pt } from '../utils/ink';

interface Props {
  class?: string;
  width?: string;
}

const { class: extraClass, width = '100%' } = Astro.props;

// A wobbly line from two random sine waves, so each divider is drawn slightly differently.
function wobblyLine(w: number, segments: number): Pt[] {
  const step = w / segments;
  const phase1 = Math.random() * Math.PI * 2;
  const phase2 = Math.random() * Math.PI * 2;
  const freq1 = 0.8 + Math.random() * 0.8;
  const freq2 = 1.5 + Math.random() * 1.5;
  const amp1 = 0.8 + Math.random() * 0.6;
  const amp2 = 0.5 + Math.random() * 0.5;
  // Wobbles around y = 4, the middle of the 8-unit-tall viewBox.
  return Array.from({ length: segments + 1 }, (_, i) =>
    [i * step, 4 + amp1 * Math.sin(phase1 + i * freq1) + amp2 * Math.cos(phase2 + i * freq2)] as Pt);
}

const pathData = toPath(wobblyLine(600, 10));
---
<svg class={['doodle-line', extraClass].filter(Boolean).join(' ')} viewBox="0 0 600 8" preserveAspectRatio="none" aria-hidden="true" focusable="false" style={`width: ${width}; height: 8px; display: block;`}>
  <path d={pathData} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
</svg>
