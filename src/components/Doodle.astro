---
// Brush-pen ink doodles that replace emoji. Drawn on a 64-unit grid with a top-left light:
// strokes press harder on the shadow side (bottom/right) and lift to hairlines for interior
// detail. perfect-freehand turns each plotted stroke into a tapered outline at build time.
import { getStroke } from 'perfect-freehand';

interface Props {
  name: 'sprout' | 'nib' | 'bulb' | 'wave' | 'sun' | 'moon';
  flip?: boolean;
  tilt?: number;
  class?: string;
}

const { name, flip = false, tilt = 0, class: extraClass } = Astro.props;

// [x, y] uses the default press curve; [x, y, pressure] sets pressure at that point (0–1).
type Pt = [number, number] | [number, number, number];
type Stroke = { p: Pt[]; w?: number };

const rotate = (strokes: Stroke[], deg: number, cx = 32, cy = 32): Stroke[] => {
  const r = (deg * Math.PI) / 180, c = Math.cos(r), s = Math.sin(r);
  return strokes.map(st => ({
    ...st,
    p: st.p.map(([x, y, pr]) => {
      const nx = cx + (x - cx) * c - (y - cy) * s, ny = cy + (x - cx) * s + (y - cy) * c;
      return (pr === undefined ? [nx, ny] : [nx, ny, pr]) as Pt;
    }),
  }));
};

// Circle drawn in one movement from the top-left, overshooting its start; heavier on the shadow side.
function inkCircle(cx: number, cy: number, r: number): Pt[] {
  const pts: Pt[] = [];
  for (let i = 0; i <= 17; i++) {
    const a = -2.4 + (i / 16) * Math.PI * 2;
    const x = cx + Math.cos(a) * r * (1 + 0.025 * Math.sin(i * 2.1));
    const y = cy + Math.sin(a) * r * (1 + 0.025 * Math.sin(i * 2.1));
    const shadow = 0.5 + 0.5 * Math.sin(a + 0.8); // peaks at bottom-right
    pts.push([x, y, 0.35 + 0.55 * shadow]);
  }
  return pts;
}

// Sixteen fine rays in an alternating long/short rhythm.
const sunRays: Stroke[] = Array.from({ length: 16 }, (_, i) => {
  const a = (i / 16) * Math.PI * 2 - Math.PI / 2;
  const inner = 15.5;
  const outer = inner + (i % 2 ? 4.5 : 8);
  return { p: [[32 + Math.cos(a) * inner, 32 + Math.sin(a) * inner], [32 + Math.cos(a) * outer, 32 + Math.sin(a) * outer]], w: 0.6 };
});

// Filament coil: small loops strung between two stems.
const coil: Pt[] = Array.from({ length: 25 }, (_, i) => {
  const t = i / 24, x = 28.6 + t * 6.8, y = 32.5 - Math.abs(Math.sin(t * Math.PI * 4)) * 2.6;
  return [x, y] as Pt;
});

const drawings: Record<Props['name'], Stroke[]> = {
  bulb: rotate([
    // glass: pear shape, lit left side light, shadow right side heavy
    { p: [[26, 44.5, 0.5], [23.5, 40, 0.45], [19, 34, 0.4], [16.2, 27, 0.4], [16.6, 20, 0.45], [20, 13.2, 0.5], [26, 8.6, 0.55], [32, 7, 0.6], [38, 8.6, 0.7], [44, 13.2, 0.8], [47.6, 20, 0.95], [48, 27, 1], [45.2, 34, 0.95], [40.6, 40, 0.8], [38.4, 44.8, 0.6]] },
    // reflection
    { p: [[21.6, 25.5], [22, 20], [25.4, 14.6]], w: 0.5 },
    // screw base: sides, curved bands, tip
    { p: [[26, 45, 0.6], [26.3, 50.5, 0.6], [26.8, 55.5, 0.5]], w: 0.8 },
    { p: [[38.2, 45, 0.9], [37.9, 50.5, 0.9], [37.4, 55.5, 0.8]], w: 0.8 },
    { p: [[25.8, 45.8], [32, 47.4], [38.4, 45.8]], w: 0.75 },
    { p: [[26.1, 49.4], [32, 51], [38, 49.4]], w: 0.75 },
    { p: [[26.4, 53], [32, 54.6], [37.7, 53]], w: 0.75 },
    { p: [[28.4, 56.8], [32, 59.2], [35.8, 56.8]], w: 0.85 },
    // filament: stems and coil
    { p: [[29.2, 45], [28.9, 39], [28.6, 32.5]], w: 0.45 },
    { p: [[34.8, 45], [35.1, 39], [35.4, 32.5]], w: 0.45 },
    { p: coil, w: 0.45 },
  ], 18),

  sprout: [
    // two strands twisting up from the ground, heavier near the base
    { p: [[30.8, 58, 0.95], [31.4, 50, 0.85], [33.2, 42, 0.7], [33.4, 36, 0.6], [32.2, 30, 0.5], [29.8, 24.6, 0.4]] },
    { p: [[33.8, 57.6, 0.8], [33.1, 50, 0.7], [31.3, 42, 0.6], [31, 36, 0.5], [32.2, 30, 0.45], [35.2, 25, 0.4]], w: 0.85 },
    // left leaf: almond, lit upper edge light, shadowed lower edge heavy
    { p: [[30, 24.8, 0.5], [28.4, 18.6, 0.4], [23, 12.8, 0.35], [14, 9.4, 0.3], [16.2, 15.4, 0.7], [22.2, 20.8, 0.9], [29.4, 24.8, 0.7]] },
    { p: [[28.5, 22.8], [22.5, 16.6], [17.4, 12.4]], w: 0.45 },
    // right leaf
    { p: [[35.2, 25, 0.5], [37.4, 18.8, 0.45], [42.6, 14.2, 0.4], [50.6, 11.6, 0.35], [47.8, 17.6, 0.8], [42, 22.2, 1], [35.6, 25.2, 0.7]] },
    { p: [[36.4, 23.4], [42, 18.2], [47.2, 14.4]], w: 0.45 },
  ],

  wave: [
    // back of the wave rising into a curling crest
    { p: [[3, 49, 0.35], [10, 46.6, 0.45], [16, 41.4, 0.55], [21, 33.6, 0.65], [26, 25.8, 0.75], [32, 19.6, 0.8], [39, 16.4, 0.85], [45, 17.6, 0.9], [49.2, 21.2, 1], [50.2, 26, 1], [48.4, 30, 0.9], [44.8, 31.6, 0.75], [41.8, 30.2, 0.6], [40.8, 27.4, 0.5], [42.6, 25, 0.4], [45, 25.8, 0.3]] },
    // the lip falling away
    { p: [[49.6, 29, 0.8], [51.8, 34.6, 0.7], [55.6, 39.2, 0.5], [61, 41, 0.3]], w: 0.9 },
    // interior lines following the crest
    { p: [[12, 47.4], [18, 40.8], [23.6, 32], [29.2, 25.2], [35.2, 21.4], [40.6, 20.8]], w: 0.5 },
    { p: [[20.2, 47], [25.2, 39.2], [30.6, 31.6], [36.2, 26.8]], w: 0.45 },
    // water line
    { p: [[3, 55.4], [12, 53.6], [22, 54.6], [32, 52.8], [42, 53.8], [52, 52], [61, 52.6]], w: 0.75 },
  ],

  sun: [{ p: inkCircle(32, 32, 10.5), w: 1.05 }, ...sunRays],

  moon: [
    // outer edge: full in the middle, fine at the horns
    { p: [[37, 8.2, 0.3], [27.6, 10, 0.55], [19.4, 16.2, 0.8], [15.6, 25.2, 1], [16.6, 35, 1], [21.8, 43.4, 0.9], [30.4, 48.8, 0.75], [40.4, 49.6, 0.55], [49.4, 45.4, 0.3]] },
    // inner edge
    { p: [[49.4, 45.4, 0.3], [41.2, 44.8, 0.45], [34.4, 40.6, 0.55], [29.8, 34, 0.6], [28.4, 26, 0.55], [30.8, 18, 0.45], [37, 8.2, 0.3]], w: 0.7 },
  ],

  nib: rotate([
    // body tapering to the point, shadow side (right) heavier
    { p: [[25.8, 21.6, 0.5], [22.8, 26, 0.45], [21.2, 32, 0.45], [22, 39, 0.5], [25.6, 46.6, 0.55], [29.6, 53, 0.55], [32, 58.2, 0.4]] },
    { p: [[38.2, 21.6, 0.7], [41.2, 26, 0.85], [42.8, 32, 0.95], [42, 39, 0.9], [38.4, 46.6, 0.8], [34.4, 53, 0.6], [32.2, 57.8, 0.35]] },
    // shoulder, slit and breather hole
    { p: [[25.4, 21.2], [32, 22.4], [38.6, 21.2]], w: 0.75 },
    { p: [[32, 56], [32, 46], [32, 37.6]], w: 0.5 },
    { p: [[32, 33.4], [30.3, 34.6], [30.8, 36.4], [32.6, 36.8], [33.8, 35.2], [32.8, 33.6]], w: 0.5 },
    // grip section
    { p: [[26, 20.8, 0.5], [26.8, 16, 0.5], [27.4, 12.2, 0.45]], w: 0.8 },
    { p: [[38, 20.8, 0.8], [37.2, 16, 0.8], [36.6, 12.2, 0.7]], w: 0.8 },
    { p: [[27, 12.6], [32, 11.6], [37, 12.6]], w: 0.7 },
  ], -28),
};

// Densify sparse hand-plotted points (Catmull-Rom), interpolating pressure where it's given.
function densify(pts: Pt[], steps = 8): number[][] {
  const P = pts.map(([x, y, p]) => [x, y, p ?? NaN]);
  if (P.length < 3) {
    const [a, b] = [P[0], P[P.length - 1]];
    return Array.from({ length: steps + 1 }, (_, i) => a.map((v, k) => v + (b[k] - v) * (i / steps)));
  }
  const out: number[][] = [];
  for (let i = 0; i < P.length - 1; i++) {
    const p0 = P[Math.max(i - 1, 0)], p1 = P[i], p2 = P[i + 1], p3 = P[Math.min(i + 2, P.length - 1)];
    for (let s = 0; s < steps; s++) {
      const t = s / steps, t2 = t * t, t3 = t2 * t;
      const f = (a: number, b: number, c: number, d: number) =>
        0.5 * (2 * b + (-a + c) * t + (2 * a - 5 * b + 4 * c - d) * t2 + (-a + 3 * b - 3 * c + d) * t3);
      out.push([f(p0[0], p1[0], p2[0], p3[0]), f(p0[1], p1[1], p2[1], p3[1]), p1[2] + (p2[2] - p1[2]) * t]);
    }
  }
  out.push(P[P.length - 1]);
  return out;
}

const strokeLength = (pts: number[][]) =>
  pts.slice(1).reduce((sum, p, i) => sum + Math.hypot(p[0] - pts[i][0], p[1] - pts[i][1]), 0);

function penStroke({ p, w = 1 }: Stroke) {
  const dense = densify(p);
  const len = strokeLength(dense);
  // Strokes without plotted pressure get a default press: touch down, fill out, lift off.
  const withPressure = dense.map(([x, y, pr], i) =>
    [x, y, Number.isNaN(pr) ? 0.3 + 0.6 * Math.sin(Math.PI * (i / (dense.length - 1)) ** 0.85) : pr]);
  return getStroke(withPressure, {
    size: 1.65 * w,
    thinning: 0.7,
    smoothing: 0.5,
    streamline: 0.15,
    simulatePressure: false,
    // Marks the stroke as finished so the end cap is drawn; short strokes otherwise collapse to nothing.
    last: true,
    start: { taper: Math.min(6, len * 0.3), cap: true },
    end: { taper: Math.min(10, len * 0.45), cap: true },
  });
}

// Standard perfect-freehand outline-to-path conversion using quadratic midpoints.
function toPath(outline: number[][]): string {
  if (!outline.length) return '';
  const avg = (a: number, b: number) => ((a + b) / 2).toFixed(2);
  const [first, ...rest] = outline;
  let d = `M${first[0].toFixed(2)} ${first[1].toFixed(2)}Q`;
  for (let i = 0; i < rest.length; i++) {
    const [x0, y0] = outline[i];
    const [x1, y1] = outline[(i + 1) % outline.length];
    d += `${x0.toFixed(2)} ${y0.toFixed(2)} ${avg(x0, x1)} ${avg(y0, y1)} `;
  }
  return d + 'Z';
}

const paths = drawings[name].map(stroke => toPath(penStroke(stroke)));

const transform = [
  flip ? 'translate(64 0) scale(-1 1)' : '',
  tilt ? `rotate(${tilt} 32 32)` : '',
].filter(Boolean).join(' ');
---
<svg class={['doodle', `doodle-${name}`, extraClass].filter(Boolean).join(' ')} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <g transform={transform || undefined}>
    {paths.map(d => <path d={d} />)}
  </g>
</svg>
