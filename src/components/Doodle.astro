---
// Continuous-line ink doodles: each subject is one or two unbroken, gently wobbling lines drawn
// with an even felt-tip weight and round ends. Line weight is set in CSS so small uses can go heavier.
interface Props {
  name: 'sprout' | 'nib' | 'bulb' | 'wave' | 'sun' | 'moon' | 'github' | 'twitter' | 'asterisk';
  flip?: boolean;
  tilt?: number;
  class?: string;
}

const { name, flip = false, tilt = 0, class: extraClass } = Astro.props;

type Pt = [number, number];

// A wobbly closed loop drawn in one movement, overshooting where it started.
function inkLoop(cx: number, cy: number, r: number): Pt[] {
  return Array.from({ length: 19 }, (_, i) => {
    const a = -2.3 + (i / 16) * Math.PI * 2;
    const k = 1 + 0.045 * Math.sin(i * 1.9) + 0.03 * Math.cos(i * 3.1);
    return [cx + Math.cos(a) * r * k, cy + Math.sin(a) * r * k] as Pt;
  });
}

const sunRays: Pt[][] = [0, 1, 2, 3, 4, 5, 6, 7].map(i => {
  const a = (i / 8) * Math.PI * 2 - Math.PI / 2 + 0.12 * Math.sin(i * 2.3);
  const inner = 17 + 0.8 * Math.sin(i * 1.7), outer = inner + 5 + 1.2 * Math.cos(i * 2.9);
  return [[32 + Math.cos(a) * inner, 32 + Math.sin(a) * inner], [32 + Math.cos(a) * outer, 32 + Math.sin(a) * outer]];
});

const drawings: Record<Props['name'], Pt[][]> = {
  // up the stem, looping out into each leaf and back
  sprout: [
    [[30.6, 58.6], [31.4, 53.4], [31.6, 48], [30.8, 40.2], [31.4, 33.4], [29, 30.4], [23.2, 29.2], [17.6, 25.4], [15, 19.4], [17.2, 16.4], [23, 18.6], [28.4, 23.6], [31.4, 30.2], [32, 27.4], [35.2, 22], [41.2, 17], [48.2, 14.2], [50.4, 16.6], [47.8, 22.6], [41.2, 26.2], [34, 27.8], [31.9, 27.2]],
  ],

  // pen held at a slant, trailing a looped line of writing from the nib
  nib: [
    [[25.8, 33.4], [50, 9], [55.6, 14.2], [31.4, 38.8], [22.4, 42.2], [25.8, 33.4], [27.4, 32.4]],
    [[44.4, 13.8], [50.6, 19.8]],
    [[22.4, 42.6], [18.6, 46.2], [14.4, 50.6], [11.2, 50.9], [12.6, 47], [16.2, 47.6], [18.6, 50.8], [22.2, 52.4], [26, 49.4], [27.8, 50.6], [30.6, 52.8], [36, 52.3], [42.6, 53.2], [48, 52.6]],
  ],

  // one line round the glass, down into two wide bands of the screw base and the tip; an arched filament
  bulb: [
    [[37.4, 45.4], [39.6, 40], [44.6, 34], [47.2, 26], [45.6, 17.4], [39.6, 11.4], [31.2, 10], [23.2, 13.4], [18.2, 21], [17.6, 29.8], [21, 37.4], [26, 43], [26.8, 46.8], [37, 46.9], [36.4, 51.8], [27.6, 51.9], [29.6, 56.4], [34.4, 56.5], [32.2, 59.4]],
    [[29.6, 45.2], [29.4, 39.8], [32, 35.6], [34.6, 39.8], [34.4, 45.2]],
    [[48.4, 9.4], [51.4, 6.2]],
    [[52.6, 15], [56.6, 13.4]],
  ],

  // water rising into a curl, then the sea line below
  wave: [
    [[4, 50.2], [12, 49.6], [18, 47.2], [23, 41.6], [27, 33.6], [32, 26.6], [38.4, 22.6], [45, 22.6], [49.6, 26.6], [50.4, 32], [47.6, 35.6], [43.2, 35.2], [41.4, 31.4], [43.6, 28.6], [46.4, 29.8]],
    [[4, 57.2], [14, 55.4], [24, 57], [34, 55], [44, 56.6], [54, 54.8], [60.4, 55.6]],
  ],

  sun: [inkLoop(32, 32, 11.5), ...sunRays],

  // one line round the outer edge and back along the inner edge of the crescent
  moon: [
    [[38, 9], [28, 11], [19.6, 18], [16, 28], [17.6, 38.6], [24, 46.6], [33.6, 50.6], [43, 49.6], [50, 44], [43, 44.6], [36.6, 41], [31.8, 34.6], [30.4, 26.4], [32.6, 17.4], [38, 9], [39, 8.4]],
  ],

  // a cat's head with pointed ears and a curling tail
  github: [
    [[21, 45], [15.6, 37], [15.8, 27.6], [17.6, 15.4], [25.4, 21.6], [32, 20.6], [38.6, 21.6], [46.4, 15.4], [48.2, 27.6], [48.4, 37], [43, 45], [36, 48.4], [28, 48.4], [21, 45], [19.6, 50.8], [15.6, 54.4], [11.6, 52.8]],
    [[25.8, 33.2], [26, 36.4]],
    [[38.2, 33.2], [38, 36.4]],
  ],

  // a small bird: tail, rounded body, head and beak, one line for the wing
  twitter: [
    [[7.6, 29.4], [15.6, 34.2], [22.4, 40.2], [30.6, 43.2], [39.4, 42], [46.4, 36.8], [49.6, 29.6], [49, 22.6], [45.4, 18.2], [40.4, 17.6], [36.4, 20.8], [34.8, 26.4], [30.6, 30.2], [21.6, 31.6], [12.6, 29.4], [7.6, 29.4]],
    [[48.4, 21.2], [55.2, 21.6], [49.8, 25]],
    [[25.4, 36.4], [31, 33.2], [37.6, 34], [34.4, 38.4]],
  ],

  asterisk: [
    [[32.4, 16], [31.6, 32], [32.2, 48]],
    [[18.4, 24.6], [32, 32.2], [45.8, 39.6]],
    [[18.6, 39.8], [32, 31.8], [45.4, 24.2]],
  ],
};

// Densify sparse hand-plotted points with a Catmull-Rom curve so the line flows smoothly.
function densify(pts: Pt[], steps = 8): Pt[] {
  if (pts.length < 3) return pts;
  const out: Pt[] = [];
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[Math.max(i - 1, 0)], p1 = pts[i], p2 = pts[i + 1], p3 = pts[Math.min(i + 2, pts.length - 1)];
    for (let s = 0; s < steps; s++) {
      const t = s / steps, t2 = t * t, t3 = t2 * t;
      const f = (a: number, b: number, c: number, d: number) =>
        0.5 * (2 * b + (-a + c) * t + (2 * a - 5 * b + 4 * c - d) * t2 + (-a + 3 * b - 3 * c + d) * t3);
      out.push([f(p0[0], p1[0], p2[0], p3[0]), f(p0[1], p1[1], p2[1], p3[1])]);
    }
  }
  out.push(pts[pts.length - 1]);
  return out;
}

const toPath = (pts: Pt[]) =>
  densify(pts).map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(2)} ${y.toFixed(2)}`).join('');

const paths = drawings[name].map(toPath);

const transform = [
  flip ? 'translate(64 0) scale(-1 1)' : '',
  tilt ? `rotate(${tilt} 32 32)` : '',
].filter(Boolean).join(' ');
---
<svg class={['doodle', `doodle-${name}`, extraClass].filter(Boolean).join(' ')} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <g transform={transform || undefined}>
    {paths.map(d => <path d={d} />)}
  </g>
</svg>
