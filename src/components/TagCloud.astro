---
interface Props {
  tags: string[];
  currentTag?: string;
}

const { tags, currentTag } = Astro.props;
const sorted = [...tags].sort();
---
<div class="tag-cloud">
  <a href="/tags/all" aria-current={currentTag === 'all' ? 'page' : undefined}><code class="tag">all</code></a>
  {sorted.map(tag => (
    <a href={`/tags/${tag}`} aria-current={tag === currentTag ? 'page' : undefined}><code class="tag">{tag}</code></a>
  ))}
</div>
