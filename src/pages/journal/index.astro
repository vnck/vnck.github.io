---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Doodle from '../../components/Doodle.astro';
import JournalEntry from '../../components/JournalEntry.astro';
import TagCloud from '../../components/TagCloud.astro';
import { render } from 'astro:content';
import { byDateDesc, getAllTags, getPublished } from '../../utils/index';

const journal = (await getPublished('journal')).sort(byDateDesc);
const tags = getAllTags(journal);

const rendered = await Promise.all(
  journal.map(async entry => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);
---
<BaseLayout title="Journal">
  <article class="post">
    <header class="post-header">
      <h1 class="post-title"><Doodle name="wave" />Journal</h1>
    </header>
    <TagCloud tags={tags} />
    <hr />
    <ul style="list-style:none;margin-left:0;padding:0;">
      {rendered.map(({ entry, Content }) => (
        <li>
          <JournalEntry
            title={entry.data.title}
            date={entry.data.date}
            modifiedDate={entry.data.modified_date}
            tags={entry.data.tags}
          >
            <Content />
          </JournalEntry>
        </li>
      ))}
    </ul>
  </article>
</BaseLayout>
