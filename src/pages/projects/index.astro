---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Doodle from '../../components/Doodle.astro';
import PostEntry from '../../components/PostEntry.astro';
import TagCloud from '../../components/TagCloud.astro';
import { byDateDesc, getAllTags, getPublished } from '../../utils/index';

const projects = (await getPublished('projects')).sort(byDateDesc);
---
<BaseLayout title="Projects">
  <article class="post">
    <header class="post-header">
      <h1 class="post-title"><Doodle name="bulb" />Projects ({projects.length})</h1>
    </header>
    <TagCloud tags={getAllTags(projects)} />
    <div class="post-content feed">
      {projects.map(post => <PostEntry post={post} />)}
    </div>
  </article>
</BaseLayout>
