---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostEntry from '../../components/PostEntry.astro';
import TagCloud from '../../components/TagCloud.astro';
import { byDateDesc, getAllTags, getPublished } from '../../utils/index';

export async function getStaticPaths() {
  const all = (await Promise.all([getPublished('writings'), getPublished('projects'), getPublished('journal')]))
    .flat()
    .sort(byDateDesc);
  const allTags = getAllTags(all);

  return ['all', ...allTags].map(tag => ({
    params: { tag },
    props: { posts: tag === 'all' ? all : all.filter(e => e.data.tags.includes(tag)), allTags },
  }));
}

const { tag } = Astro.params;
const { posts, allTags } = Astro.props;
---
<BaseLayout title={tag === 'all' ? 'All posts' : `Tag: ${tag}`}>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">
        {tag === 'all'
          ? `All posts (${posts.length})`
          : <span>Tag: <span class="tag-header">{tag}</span> ({posts.length})</span>
        }
      </h1>
    </header>
    <TagCloud tags={allTags} currentTag={tag} />
    <div class="post-content feed">
      {posts.map(post => <PostEntry post={post} />)}
    </div>
  </article>
</BaseLayout>
