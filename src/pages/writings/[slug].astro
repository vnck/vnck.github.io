---
import PostPage from '../../components/PostPage.astro';
import { deriveSlug, getPublished } from '../../utils/index';

export async function getStaticPaths() {
  const entries = await getPublished('writings');
  return entries.map(entry => ({
    params: { slug: deriveSlug(entry.id, entry.data.permalink) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---
<PostPage entry={entry} />
