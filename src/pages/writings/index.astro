---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Doodle from '../../components/Doodle.astro';
import PostEntry from '../../components/PostEntry.astro';
import TagCloud from '../../components/TagCloud.astro';
import { byDateDesc, getAllTags, getPublished } from '../../utils/index';

const writings = (await getPublished('writings')).sort(byDateDesc);
---
<BaseLayout title="Writings">
  <article class="post">
    <header class="post-header">
      <h1 class="post-title"><Doodle name="nib" />Writings ({writings.length})</h1>
    </header>
    <TagCloud tags={getAllTags(writings)} />
    <div class="post-content feed">
      {writings.map(post => <PostEntry post={post} />)}
    </div>
  </article>
</BaseLayout>
