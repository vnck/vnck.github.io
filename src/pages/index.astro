---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostEntry from '../components/PostEntry.astro';
import SplitFlap from '../components/SplitFlap.astro';
import Doodle from '../components/Doodle.astro';
import { byDateDesc, getPublished } from '../utils/index';

const [writings, projects] = await Promise.all([getPublished('writings'), getPublished('projects')]);
const recent = [...writings, ...projects].sort(byDateDesc).slice(0, 5);
---
<BaseLayout>
  <div class="home">
    <h1 class="home-title"><Doodle name="sprout" /><Doodle name="sprout" flip tilt={-8} /> IVAN <Doodle name="sprout" tilt={6} /></h1>
    <p class="home-tagline"><SplitFlap phrases={[
      "Writing to make sense of technology and the cities;",
      "Digital placemaking;",
      "Public garden;",
      "Thinking out into the void;"
    ]} /></p>
    <hr />

    <h2>Recently,</h2>
    <br />
    <div class="feed">
      {recent.map(post => <PostEntry post={post} />)}
    </div>
    <p class="archive-link"><a href="/writings">all writings ›</a> &ensp; <a href="/projects">all projects ›</a></p>
  </div>
</BaseLayout>
